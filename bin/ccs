#!/usr/bin/env bash
# ccs — Claude Code Search: grep all Claude Code sessions, pick one, resume it.
#
# Usage:
#   ccs <pattern>          search all sessions (smart-case regex, via ripgrep)
#   ccs                    no pattern: browse all sessions, newest first
#
# Pick a session in fzf (preview shows matching lines) and it runs
# `claude --resume <session-id>` from that session's original directory.

set -euo pipefail

PROJECTS_DIR="$HOME/.claude/projects"

# Internal: fzf preview renderer — extract readable text around matches
if [[ "${1:-}" == "--preview" ]]; then
  pat="${2:-}" file="$3"
  if [[ -n "$pat" ]]; then
    lines=$(rg -S -m20 "$pat" "$file" 2>/dev/null || true)
    # Pull just the human-readable string values that matched, not raw JSON;
    # filter to lines containing the pattern BEFORE truncating
    extracted=$(echo "$lines" | jq -r --arg p "$pat" \
      '[.. | strings | select(test($p; "i"))] | .[]' 2>/dev/null \
      | rg -S --color=always -m30 "$pat" 2>/dev/null \
      | awk '!seen[$0]++' | head -30 || true)
    if [[ -n "$extracted" ]]; then
      echo "$extracted" | cut -c1-500
    else
      echo "$lines" | cut -c1-400
    fi
  else
    tail -50 "$file" | jq -r 'select(.message.content) | .message.content
      | if type == "string" then . else ([.[]? | select(.type? == "text") | .text] | join(" ")) end' \
      2>/dev/null | tail -30 || true
  fi
  exit 0
fi

PATTERN="${1:-}"

command -v rg >/dev/null || { echo "ccs: ripgrep (rg) is required" >&2; exit 1; }
command -v fzf >/dev/null || { echo "ccs: fzf is required (brew install fzf)" >&2; exit 1; }
command -v jq >/dev/null || { echo "ccs: jq is required" >&2; exit 1; }

# --- 1. Find candidate session files ---------------------------------------
if [[ -n "$PATTERN" ]]; then
  files=$(rg -lS --no-messages -g '*.jsonl' "$PATTERN" "$PROJECTS_DIR" || true)
else
  files=$(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' 2>/dev/null)
fi

[[ -n "$files" ]] || { echo "ccs: no sessions matching '$PATTERN'" >&2; exit 1; }

# Keep only top-level session transcripts named <uuid>.jsonl (skip agent/sidechain files)
uuid_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.jsonl$'
files=$(while IFS= read -r f; do
  if [[ "$(basename "$f")" =~ $uuid_re ]]; then echo "$f"; fi
done <<<"$files")

[[ -n "$files" ]] || { echo "ccs: matches found only in non-resumable (agent) transcripts" >&2; exit 1; }

# --- 2. Build rows: mtime \t sid \t cwd \t file \t date \t short_cwd \t title
rows=$(while IFS= read -r f; do
  sid="$(basename "$f" .jsonl)"
  mtime=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f")
  date=$(date -r "$mtime" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')

  # cwd: first occurrence in the transcript
  cwd=$(rg -m1 -o '"cwd":"[^"]*"' "$f" 2>/dev/null | head -1 | sed 's/"cwd":"//;s/"$//' || true)

  # title: firstPrompt from sessions-index.json if present, else first user message
  idx="$(dirname "$f")/sessions-index.json"
  title=""
  if [[ -f "$idx" ]]; then
    title=$(jq -r --arg sid "$sid" \
      '.entries[]? | select(.sessionId == $sid) | .firstPrompt // empty' "$idx" 2>/dev/null | head -1)
  fi
  if [[ -z "$title" ]]; then
    title=$(jq -r 'select(.type == "user") | .message.content
                   | if type == "string" then . else (.[]? | select(.type? == "text") | .text) end' \
            "$f" 2>/dev/null | head -1 || true)
  fi
  title=$(echo "$title" | tr '\n\t' '  ' | cut -c1-100)

  short_cwd="${cwd/#$HOME/~}"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$mtime" "$sid" "$cwd" "$f" "$date" "${short_cwd:-?}" "${title:-(no prompt)}"
done <<<"$files" | sort -rn)

# --- 3. Pick with fzf -------------------------------------------------------
preview="$(printf '%q' "$0") --preview $(printf '%q' "$PATTERN") {4}"

selected=$(echo "$rows" | fzf \
  --delimiter='\t' \
  --with-nth=5,6,7 \
  --preview="$preview" \
  --preview-window='down,40%,wrap' \
  --header="resume session ${PATTERN:+matching \"$PATTERN\"}" \
  --no-multi) || exit 130

sid=$(echo "$selected" | cut -f2)
cwd=$(echo "$selected" | cut -f3)

# --- 4. Resume from the session's original directory ------------------------
if [[ -d "$cwd" ]]; then
  cd "$cwd"
else
  echo "ccs: original cwd '$cwd' no longer exists; resuming from \$HOME" >&2
  cd "$HOME"
fi
echo "Resuming $sid in $(pwd)" >&2
exec claude --resume "$sid"
